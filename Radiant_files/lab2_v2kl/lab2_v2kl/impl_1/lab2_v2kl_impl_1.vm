module lab2_keypad (input reset, input enable, input [3:0]col, output [3:0]row, 
            output [3:0]led);
    
    wire GND_net;
    wire reset_c;
    wire enable_c;
    wire [3:0]col_c;
    wire VCC_net;
    
    VHI i6 (.Z(VCC_net));
    OB \led_pad[0]  (.I(col_c[0]), .O(led[0]));
    OB \led_pad[1]  (.I(col_c[1]), .O(led[1]));
    OB \led_pad[2]  (.I(col_c[2]), .O(led[2]));
    OB \led_pad[3]  (.I(col_c[3]), .O(led[3]));
    OB \row_pad[0]  (.I(VCC_net), .O(row[0]));
    OB \row_pad[1]  (.I(GND_net), .O(row[1]));
    OB \row_pad[2]  (.I(GND_net), .O(row[2]));
    OB \row_pad[3]  (.I(GND_net), .O(row[3]));
    IB \col_pad[0]  (.I(col[0]), .O(col_c[0]));
    IB \col_pad[1]  (.I(col[1]), .O(col_c[1]));
    IB \col_pad[2]  (.I(col[2]), .O(col_c[2]));
    IB \col_pad[3]  (.I(col[3]), .O(col_c[3]));
    IB enable_pad (.I(enable), .O(enable_c));
    IB reset_pad (.I(reset), .O(reset_c));
    VLO i5 (.Z(GND_net));
    
endmodule
